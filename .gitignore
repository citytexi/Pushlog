# Gradle
.gradle/
.kotlin/
# Build output of the root and of every module depth (app, feature/x, core/testing/x,
# build-logic/convention). Anchored on purpose: an unanchored `build/` would also hide
# source packages such as src/main/kotlin/com/build/.
/build/
/*/build/
/*/*/build/
/*/*/*/build/
/*/*/*/*/build/

# Local configuration (SDK path, signing keys)
local.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.DS_Store

# Android (Android Studio captures, anchored like build/ above)
/captures/
/*/captures/
/*/*/captures/
/*/*/*/captures/
/*/*/*/*/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
output.json
*.hprof

# Python (wiki/docs scripts)
__pycache__/
.pytest_cache/

# graphify outputs that differ per machine
/wiki/graphify-out/cost.json
/wiki/graphify-out/cache/
/wiki/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
/wiki/pages/graphify-out/cache/
